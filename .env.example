# Application
APP_ENV=dev
BASE_CURRENCY=USD

# Database
DATABASE_URL=mysql+pymysql://synapse:password@127.0.0.1:3306/synapse_yield

# Broker: local_sim or longbridge
BROKER_TYPE=local_sim

# External order safety switches
ENABLE_EXTERNAL_ORDER_SUBMISSION=false
ENABLE_LIVE_TRADING=false

# Longbridge local safety label: paper or live
LONGBRIDGE_MODE=paper

# Longbridge OpenAPI credentials
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# Longbridge integration tests; keep both false during normal pytest runs
RUN_LONGBRIDGE_INTEGRATION=false
RUN_LONGBRIDGE_PAPER_ORDER=false
LONGBRIDGE_TEST_SYMBOL=AAPL.US

# LLM trading Agent. The model can only propose; every trade still requires human approval.
ENABLE_LLM_TRADING_AGENT=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
